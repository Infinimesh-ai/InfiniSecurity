# InfiniSecurity 系统级 LSM 层(M6)。
#
# 与 infinisecd 的关系是**兜底**而不是重复:
#   - seccomp 层(infinisecd)覆盖经 infsec run 启动的进程树,做精细判决;
#   - LSM 层覆盖全系统(含未经 infsec run 启动的进程),只做 T0 绝对拦截。
# 两层都在时,先经过哪层取决于 syscall 路径,但拒绝语义一致。
#
# 前置:内核参数含 lsm=...,bpf(改 /etc/default/grub 后 update-grub 并重启)。

[Unit]
Description=InfiniSecurity system-wide eBPF LSM enforcement
Documentation=https://github.com/Infinimesh-ai/InfiniSecurity
After=local-fs.target
Before=infinisecd.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/bin/sh -c 'grep -q bpf /sys/kernel/security/lsm || { echo "内核未启用 bpf LSM(内核参数需含 lsm=...,bpf)"; exit 1; }'
ExecStartPre=/bin/mkdir -p /sys/fs/bpf/infsec
ExecStart=/usr/local/bin/infsec-lsm-load
# 重新加载会建出**全新清零的 map**:enabled=0(observe,内核层什么都不拦)、
# protected_prefixes 全零、exempt_pid=0。而写策略进 map 的
# sync_prefixes/set_config 只在 infinisecd **启动时**跑一次(没有 SIGHUP、
# 没有周期重同步)。所以单独 `systemctl restart infinisec-lsm` 会让内核层
# 静默解除武装,直到有人恰好也重启了 infinisecd——一个"重启了防护组件反而
# 没了防护"的陷阱,而且从外部完全看不出来。
# 用 --no-block 避免与本单元的 Before=infinisecd.service 顺序关系死锁。
ExecStartPost=-/usr/bin/systemctl --no-block try-restart infinisecd.service
ExecStop=/bin/sh -c 'rm -rf /sys/fs/bpf/infsec'

[Install]
WantedBy=multi-user.target
